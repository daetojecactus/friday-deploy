# Копируется в .env: cp .env.example .env

# Адреса. Пусто — вычисляются из заголовка Host: открыли стенд по адресу
# машины, и внутренний контур подставился сам. Заполнять только за пробросом
# портов или под доменным именем.
STAND_PUBLIC_HOST=
CORP_ORIGIN=

STAND_PUBLIC_PORT=8080
CORP_PUBLIC_PORT=7070

# Имя внутреннего контура. Нигде не резолвится: только в заголовках и данных.
CORP_BRAND_HOST=corp.test.kz

MONGO_URI=mongodb://mongo:27017/forensics

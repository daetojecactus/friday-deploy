# Скопируйте этот файл в .env: cp .env.example .env
#
# Подключение приложения к MongoDB. В уроке этот файл НЕ правится: конфиг
# приложения эталонный, все поломки живут внутри самой базы.
#
# Пользователи заведены в базе crm (см. internal/mongo-init/01-users.js):
#   crm_app  / app_secret      — приложение: readWrite
#   engineer / engineer_secret — инженер: readWrite + dbAdmin

MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_USER=crm_app
MONGO_PASSWORD=app_secret
MONGO_DB=crm
MONGO_AUTH_SOURCE=crm

# Адрес стенда в локальной сети для готовой строки подключения на вкладке
# «Система». Обычно не нужен: страница подставляет тот адрес, по которому ее
# открыли. Заполняется, если стенд живет за пробросом портов, VPN или именем.
#   узнать адрес машины: hostname -I | awk '{print $1}'
# STAND_PUBLIC_HOST=192.168.1.50

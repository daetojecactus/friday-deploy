# Скопируйте этот файл в .env: cp .env.example .env
# Значения ниже — эталон, при котором все 10 проверок зеленые.

# Backend
PORT=3000

# PostgreSQL — host = имя контейнера в docker-сети (см. docker-compose.yml)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app

# Redis — сервер поднят с паролем (см. docker-compose.yml)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=secret

# Vendor API — базовый адрес внешнего вендора. Проверки ходят к нему как
# VENDOR_API_URL + метод (/data, /profile, /status, /balance). Версия пути (v2)
# зашита в базовый адрес.
VENDOR_API_TOKEN=sk_live_valid_2026
VENDOR_API_URL=http://127.0.0.1:3000/vendor/api/v2

# Rate limiting (Redis)
REDIS_RATE_LIMIT_MAX=100
REDIS_RATE_LIMIT_WINDOW_SEC=10
